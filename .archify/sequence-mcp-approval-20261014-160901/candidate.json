  "cards": [
    {
      "dot": "rose",
      "title": "Gate Semantics",
      "items": [
        "Nothing on the true branch runs until the Review page returns Approve",
        "Reject ends the run: nothing is written and no draft is created"
      ]
    },
    {
      "dot": "emerald",
      "title": "Idempotency And Safety",
      "items": [
        "The agent is told to call each tool exactly once and pass the text unchanged",
        "It is told never to send an email; the draft has no recipient",
        "The Google Doc is fixed inside the MCP server, so a caller cannot pick another"
      ]
    },
    {
      "dot": "cyan",
      "title": "Auth And Isolation",
      "items": [
        "The MCP server requires a Bearer token",
        "In this variant the direct Docs and Gmail nodes are deactivated"
      ]
    }
