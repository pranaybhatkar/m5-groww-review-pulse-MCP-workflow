  "cards": [
    {
      "dot": "emerald",
      "title": "Rows Shrink Deliberately",
      "items": [
        "The raw scrape holds 4,908 rows; cleaning leaves 2,439 usable reviews",
        "Themes run on 400 random reviews; the fee signal runs on 150 fee-related reviews",
        "Every count in the report is computed in code, not guessed by the model"
      ]
    },
    {
      "dot": "rose",
      "title": "Nothing Leaves Before Approval",
      "items": [
        "Checks verify quotes word for word and cap the pulse length",
        "The human approval gate is the last step before any write",
        "Reject ends the run with nothing saved or drafted"
      ]
    },
